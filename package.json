{
	"name": "tshirt-blender",
	"description": "Composite artwork onto t-shirt photos with fabric-aware shading and displacement",
	"version": "0.0.1",
	"bin": {
		"tshirt-blender": "./dist/cli.mjs"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"scripts": {
		"dev": "tsdown --watch",
		"execute": "bun ./dist/cli.mjs",
		"cli": "bun src/cli.ts",
		"build": "tsdown",
		"test:run": "vitest run --silent",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write --unsafe .",
		"format": "biome format .",
		"format:write": "biome format . --write",
		"typecheck": "tsc --noEmit",
		"release": "tsc --noEmit && npm run build && npm publish"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.5",
		"@types/bun": "latest",
		"@types/inquirer": "^9.0.10",
		"tsdown": "^0.23.0",
		"vitest": "^4.1.10"
	},
	"peerDependencies": {
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"@ts-utilities/notify": "^0.1.12",
		"commander": "^15.0.0",
		"inquirer": "^14.0.2",
		"sharp": "^0.35.3"
	},
	"license": "MIT",
	"keywords": [
		"tshirt",
		"print",
		"sharp",
		"cli",
		"bun"
	],
	"author": {
		"name": "Sohan Emon",
		"email": "sohanemon@outlook.com"
	},
	"exports": {
		".": "./dist/cli.mjs",
		"./package.json": "./package.json"
	}
}
